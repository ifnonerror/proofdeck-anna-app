{
  "name": "proofdeck",
  "version": "0.2.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A source-grounded AI presentation builder for Anna.",
  "scripts": {
    "build": "node scripts/build-engine.mjs && node scripts/build.mjs",
    "build:engine": "node scripts/build-engine.mjs",
    "dev": "anna-app dev --no-llm --slug proofdeck",
    "dev:real": "anna-app dev --slug proofdeck",
    "dev:mock": "anna-app dev --mock-llm fixtures/llm-deck.jsonl --slug proofdeck",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke-export.mjs && node scripts/smoke-office-engine.mjs",
    "smoke:template": "node scripts/check-template.mjs",
    "validate": "anna-app validate --strict",
    "check": "npm run test && npm run smoke && npm run validate"
  },
  "dependencies": {
    "@office-kit/pptx": "^0.28.0",
    "@office-kit/pptx-preview": "^0.21.0",
    "mammoth": "^1.10.0",
    "pdfjs-dist": "^5.4.394",
    "pptxgenjs": "4.0.1"
  },
  "devDependencies": {
    "@anna-ai/cli": "0.1.64",
    "esbuild": "^0.25.12",
    "jszip": "3.10.2",
    "playwright-core": "^1.56.1"
  }
}
